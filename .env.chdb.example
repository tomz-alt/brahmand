# chdb Connection Settings
# Copy this file to .env for chdb testing

# For chdb embedded mode (local file)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Brahmand Server Settings
BRAHMAND_HOST=0.0.0.0
BRAHMAND_PORT=8080

# Database Type
DATABASE_TYPE=clickhouse

# Notes:
# - chdb is an embedded ClickHouse database
# - Can run in-process without a separate server
# - Compatible with ClickHouse HTTP protocol
# - Perfect for local testing and development
#
# Installation:
#   pip install chdb
#
# Usage:
#   1. Start chdb server or use embedded mode
#   2. Copy this file: cp .env.chdb.example .env
#   3. Start Brahmand: cargo run --bin brahmand
#   4. Use client: cargo run --bin brahmand-client
