# VeloDB Connection Settings
# Copy this file to .env.velodb and fill in your actual credentials
VELODB_HOST=your-velodb-host.example.com
VELODB_PORT=9030
VELODB_USER=your_username
VELODB_PASSWORD=your_password
VELODB_DATABASE=your_database

# Brahmand Server Settings
BRAHMAND_HOST=0.0.0.0
BRAHMAND_PORT=8080

# Database Type (clickhouse or velodb)
DATABASE_TYPE=velodb
